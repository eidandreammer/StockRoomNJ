{
  "name": "stockroomnj",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run tests/eventModel.test.js tests/bidMath.test.js",
    "test:rules": "firebase emulators:exec --project stockroomnj-rules-test --only firestore \"vitest run tests/firestore.rules.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "deploy:rules": "firebase deploy --project stockroomnj-10e7d --only firestore:rules,storage",
    "functions:lint": "npm --prefix functions run lint",
    "migrate:legal": "npm --prefix functions run migrate:legal"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/luxon3": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/rrule": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "firebase": "^12.14.0",
    "gsap": "^3.15.0",
    "heic-to": "^1.5.2",
    "luxon": "^3.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.19.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
