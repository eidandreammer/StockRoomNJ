rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && (
          request.resource == null
          || (
            request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')
          )
        );
    }

    match /legal-documents/{documentType}/{versionNumber}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && documentType in ['TOS', 'PRIVACY_POLICY']
        && (
          request.resource == null
          || (
            request.resource.size < 10 * 1024 * 1024
            && (
              (request.resource.contentType == 'application/pdf' && fileName.matches('.*\\.pdf'))
              || (request.resource.contentType == 'text/markdown' && fileName.matches('.*\\.md'))
              || (request.resource.contentType == 'text/plain' && fileName.matches('.*\\.txt'))
            )
          )
        );
    }
  }
}
