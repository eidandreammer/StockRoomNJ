# =========================================================================
# StockRoom NJ Environment Variables Template
# =========================================================================
#
# INSTRUCTIONS:
# 1. Local Development: Copy this file to `.env` and fill in the values.
# 2. Production: Use `.env.production.local` for production build variables.
#    Never commit `.env` or `.env.production.local` files to Git.
#
# IMPORTANT RULES:
# - All frontend variables compiled by Vite MUST start with `VITE_`.
# - NEVER commit real keys, private keys, service-account JSONs, or production secrets.
# - Firebase Extension SMTP settings belong in the Firebase Console configuration,
#   not in frontend environment files.
# =========================================================================

# --- Firebase Client SDK Configuration (Local & Production) ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="stockroomnj-10e7d"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Set to "true" to connect to local Firebase emulators (Auth, Firestore, Storage, Functions).
# Under the local Auth emulator, TOTP MFA is bypassed since the Auth emulator does not support TOTP MFA generation.
VITE_USE_FIREBASE_EMULATORS="false"

# --- Google reCAPTCHA v2 configuration ---
# Checkbox site key for the admin login gate.
VITE_RECAPTCHA_SITE_KEY=""

# Optional local-only bypass. Keep this "false" in production.
VITE_DISABLE_RECAPTCHA="false"

# --- API Base URL configuration ---
# Keep empty in production because Firebase Hosting automatically rewrites `/api/**` to the Firebase Function.
# Set only if proxying to a custom endpoint or testing locally without standard rewrites.
VITE_API_BASE_URL=""

# --- Firebase Trigger Email Extension Configuration ---
# Kept in Firestore trigger functions (local/production configuration helper).
# Note: Real SMTP credentials must be configured directly in the Firebase Console/Extension settings.
FIREBASE_EMAIL_COLLECTION="mail"
FIREBASE_EMAIL_FROM="thestockroomnj@gmail.com"

# --- Google Maps API Key ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
