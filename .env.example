VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Set to true to connect to local Firebase emulators (Auth, Firestore, Storage).
# Under the local Auth emulator, TOTP MFA is bypassed since the Auth emulator does not support TOTP MFA generation.
VITE_USE_FIREBASE_EMULATORS="false"

# Google reCAPTCHA v2 checkbox site key for the admin login gate.
VITE_RECAPTCHA_SITE_KEY=""

# Optional local-only bypass. Keep this false in production.
VITE_DISABLE_RECAPTCHA="false"

# Optional. Leave empty when Firebase Hosting rewrites /api/** to the Functions API.
VITE_API_BASE_URL=""

# Optional Cloud Functions email queue configuration for the Firebase Trigger Email from Firestore extension.
FIREBASE_EMAIL_COLLECTION="mail"
FIREBASE_EMAIL_FROM="thestockroomnj@gmail.com"

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
