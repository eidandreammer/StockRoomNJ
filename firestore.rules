rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /events/{eventId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /legal_documents/{documentId} {
      allow get, list: if resource.data.is_active == true || isAdmin();
      allow write: if false;
    }

    match /user_agreements/{agreementId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    match /bids/{bidId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
